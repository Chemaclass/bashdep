#!/bin/bash
echo "Running pre-commit checks"

# Skip tests + ShellCheck when no shell-related files are staged.
# editorconfig-check runs regardless because it validates whitespace
# and indent on docs too.
SHELL_PATHS_RE='(\.sh$|^bashdep$|^bin/pre-commit$|^Makefile$|^release\.sh$|^tests/)'
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
SHELL_CHANGED=false
if [[ -n "$STAGED" ]] && echo "$STAGED" | grep -Eq "$SHELL_PATHS_RE"; then
  SHELL_CHANGED=true
fi

if $SHELL_CHANGED; then
  make pre_commit/run
else
  echo "No shell-related files staged — skipping tests + ShellCheck."
  make lint
fi
EXIT_CODE=$?

if [[ ${EXIT_CODE} -ne 0 ]]; then
    echo "Pre Commit checks failed. Please fix the above issues before committing"
    exit ${EXIT_CODE}
else
    echo "Pre Commit checks passed, no problems found"
    exit 0
fi
